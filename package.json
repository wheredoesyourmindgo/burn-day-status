{
  "name": "burn-day-status",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx --yes --loglevel=error only-allow npm",
    "dev": "vc dev",
    "vc": "vc",
    "vc:prod": "vc --prod",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --config .prettierrc --write './src/**/*.{ts,tsx,css}'",
    "type-check": "tsc --noEmit -p .",
    "type-check:watch": "npm run type-check -- --watch",
    "clean": "rimraf node_modules .next .vercel/cache",
    "reinstall": "npm run clean && npm ci",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run type-check && npm run lint && npm run build && npm run audit",
    "deps:check": "npm outdated || true",
    "deps:upgrade": "npx --yes npm-check-updates --interactive --format group --target minor",
    "deps:upgrade:major": "npx --yes npm-check-updates --interactive --format group --target latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@vercel/analytics": "^2.0.1",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "string-hash": "^1.1.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/string-hash": "^1.1.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vercel": "^59.23.2"
  }
}
